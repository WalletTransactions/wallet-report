# syntax=docker/dockerfile:1
#
# Собирает и запускает wallet_report_integration_tests (test_reports.cpp) —
# НЕ образ сервиса (тот — ../Containerfile, тесты туда сознательно не входят,
# см. его же комментарий). Используется run_local.sh, вручную не нужен.
#
# Тот же базовый образ и набор пакетов, что у ../Containerfile (стадия build):
# держим их идентичными нарочно — если тестовая сборка однажды перестанет
# компилироваться в этом окружении, а прод-образ соберётся, это будет
# означать, что окружения разошлись, а не что тест сломан.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        libssl-dev \
        libpq-dev \
        zlib1g-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY CMakeLists.txt VERSION openapi.yaml ./
COPY src/ src/
COPY third_party/ third_party/
COPY scripts/ scripts/
COPY tests_integration/ tests_integration/

ARG BUILD_JOBS=3
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release -DWALLET_REPORT_BUILD_INTEGRATION_TESTS=ON \
    && cmake --build build --target wallet_report_integration_tests --config Release -j"${BUILD_JOBS}"

ENTRYPOINT ["/src/build/tests_integration/wallet_report_integration_tests"]
