# Адрес auth-сервиса — отсюда wallet-report тянет публичные ключи (GET
# /.well-known/jwks.json) для проверки подписи access-токена. Никакого
# общего секрета заводить не нужно (тот же приём, что в wallet-api/
# wallet-gateway).
AUTH_SERVICE_URL=http://127.0.0.1:8080

# ТА ЖЕ база, что использует wallet-api (шареная БД, см. README, "Шареная
# БД, разные роли"), но ролью wallet_reader (см.
# wallet-api/schema/role/wallet_reader.sql, накатана миграцией 000002_ledger_sync).
# Read-only физически: у роли нет прав INSERT/UPDATE/DELETE, даже если бы в
# отчётном коде когда-нибудь завёлся баг. Пароль 'wallet_reader' — дефолт для
# локальной разработки (см. сам файл роли); для стенда с реальными данными
# меняется отдельно.
REPORTS_DATABASE_URL=postgresql://wallet_reader:wallet_reader@localhost:5432/wallet_api

# Сколько соединений держать одновременно в пуле (см. src/db.hpp::Pool) — по
# прямому запросу, взамен единственного соединения на весь процесс: один
# показ "Отчётов" на веб-клиенте — уже ~8-10 параллельных запросов, на одном
# соединении они сериализовались бы полностью. 8 по умолчанию — с запасом
# покрывает такую пачку, не открывая существенно больше соединений к
# Postgres, чем нужно.
# REPORTS_DB_POOL_SIZE=8

PORT=8084
# 127.0.0.1 — только локально. На Linux-сервере, слушающем внешние
# подключения, поставьте HOST=0.0.0.0.
HOST=127.0.0.1

# Куда писать логи — папка, внутри неё файл на каждый день
# ("<LOG_DIR>/2026-09-08-wallet-report.log", ротация — по смене даты). По
# умолчанию (если не задано):
#   Windows — папка "logs" в рабочей директории;
#   Linux/Docker — stdout/stderr.
# LOG_DIR=var/log/wallet-report
# LOG_DIR=stdout

# true/1 — писать в лог ещё и значения параметров SQL-запросов ($1, $2, ...),
# не только сам текст запроса (см. README, "Логирование"). По умолчанию
# выключено: параметры — произвольные данные приложения, включайте только
# для локальной отладки.
# LOG_SQL_PARAMS=true

# Доп. имена параметров (через запятую), чьи значения exec() маскирует "***"
# в логе при LOG_SQL_PARAMS=true — расширяет встроенный набор
# password/client_secret/refresh_token/access_token/id_token/token/secret
# (см. builtin_mask_param_names() в src/db.cpp), а не заменяет его.
# LOG_SQL_MASK_PARAMS=api_key,pin
